# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments / uv
.venv/
.venv*/
venv/
uv.lock.tmp

# Environment / secrets — the neuPrint token lives here and must never be committed
.env
.env.*
!.env.example

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Connectome cache (fetched at runtime; not redistributed for licensing reasons)
data/**
!data/**/.gitkeep

# Training artifacts: checkpoints, TensorBoard logs, evaluation outputs
artifacts/**
!artifacts/**/.gitkeep

# Per-run output layout (UC-11): training/<name>/{checkpoints,logs,recordings}/
training/**
!training/**/.gitkeep

# Desktop app (UC-61) per-machine local state (settings.json etc.)
.dev-app/

# Model / RL byproducts
*.pt
*.pth
*.ckpt
*.zip
events.out.tfevents.*

# OS / editor
.DS_Store
.idea/
.vscode/

