# Copy to .env and fill in. The real .env is gitignored and must never be committed.
#
# Get a free neuPrint auth token from https://neuprint.janelia.org (Account menu).

# neuPrint server hosting the MaleCNS connectome.
NEUPRINT_SERVER=https://neuprint.janelia.org

# The MaleCNS dataset name on that server (verify the exact current name on neuPrint).
NEUPRINT_DATASET=male-cns

# Your personal neuPrint auth token (JWT). Keep this secret.
NEUPRINT_TOKEN=
