# Copy to .env and fill in. The real .env is gitignored and must never be committed.
#
# Get a free neuPrint auth token from https://neuprint.janelia.org (Account menu).

# neuPrint server hosting the MaleCNS connectome.
NEUPRINT_SERVER=https://neuprint.janelia.org

# The MaleCNS dataset name on that server (verify the exact current name on neuPrint).
NEUPRINT_DATASET=male-cns

# Your personal neuPrint auth token (JWT). Keep this secret.
#
# UC-05 note: anatomical soma positions for the committed fixture are provisioned TOKENLESSLY
# (from the connectome_data_prep `somaLocation` column via scripts/fetch_soma_positions.py),
# so the activation viewer's anatomical brain map works offline with NO token. A token is only
# needed to fetch soma positions for arbitrary custom slices whose bodyids are not in a
# committed sidecar CSV; without one, such neurons use the deterministic computed-layout fallback.
NEUPRINT_TOKEN=

# UC-05 (optional): path to a local anatomical soma CSV (bodyid,x,y,z — or a connectome_data_prep
# meta with a `somaLocation` column). Overrides the fixture sidecar lookup for the brain map.
# DRONE_FLY_SOMA_CSV=
